# Profile: impulse -- trade the underlying's move, not the model's opinion.
#
# Live arm (A). The model gate keeps being recorded from `quotes`+`rounds`, so
# the A/B is reconstructible offline on exactly the same rounds (arm B).
#
# Evidence, 2026-09-12, 96,800 recorded ticks / 1,641 rounds, one entry per
# round, filled at the venue ask, net of the measured 1.32c/$1 slippage:
#
#   window  threshold   1st half   2nd half (out of sample)
#    1s       >=4 bps   +0.1145      +0.0815
#    1s       >=5 bps   +0.1137      +0.2130
#    2s       >=5 bps   +0.1365      +0.1499
#    5s       >=5 bps   +0.0961      +0.0910
#    1s       >=2 bps   +0.0253      -0.0999   <- noise, refused
#   live model gate (same rounds): +0.0129 net, second half -0.0081
#
# Positive in both halves at every threshold >= 4 bps, across four independent
# window choices; underpowered (t 0.4-0.6 out of sample, ~4,000 trades needed
# for t=2), so this runs at the venue minimum with the guards ON and one entry
# per round. The risk to watch is NOT the win rate: it is the fill price on
# impulse entries, where adverse selection lives. Measure realised fill vs the
# impulse-trigger price for the first 200 entries.
#
# Apply with:  python -m tools.switch_env impulse --restart
entry_mode=impulse
impulse_window_s=2.0
impulse_bps=4.0
impulse_min_price=0.05
impulse_max_price=0.75
# Evaluate the trigger on the feed's clock, not on the 1 s poll. Measured from
# the VPS 2026-09-12: the venue answers in 5.3 ms and three round trips cost
# 16 ms, while the poll looked at the price every 1002 ms -- so the poll WAS the
# trigger-to-order latency (~500 ms median, 1 s worst case) and the side being
# bought keeps drifting for seconds after the impulse. Orders now go out ~20 ms
# after the window closes. Set false to go back to the poll-sampled trigger.
impulse_on_tick=true
order_type=market
slippage_bps=300
sizing_mode=fraction
stake_fraction=0.02
stake_cap_usdt=25.0
stake_floor_to_minimum=true
stake_tilt=inv_z
tilt_reference_z=0.30
tilt_min=0.5
tilt_max=2.0
min_order_usdt=1.0
# --- ticket arm (paper only, additive to everything above) ---------------
# A $1 ticket on the cheap side, fired only when the flip is genuinely live:
# the price within 2 bps of the strike while the venue still quotes that side at
# 0.02-0.05. It runs on its own paper broker and its own ledger
# (fills.mode='ticket'): it cannot touch the bankroll, the risk guard, the
# redeem path or the live order endpoint while it is unproven. Decision rows
# from it are identifiable by reason LIKE 'ticket %'.
ticket_enabled=true
ticket_stake_usdt=1.0
ticket_min_price=0.02
ticket_max_price=0.05
# 0.25 - 2.0. Extended Polymarket sample (14 days, one ticket per round, tau
# 3-30s, net of fee): dist<1bp n=110 WR 17.3% vs a 0.0428 price = 4.04x
# (EV +3.56, t 3.0); 1-2bp n=175 = 1.92x (EV +1.97, t 2.1); <2bp pooled n=243
# = 2.57x (EV +2.31, t 3.2, day-clustered t 2.76, 10 of 13 days positive,
# survives dropping the best day). Past 2 bps there is NO edge on EITHER venue
# (Polymarket 2-3bp 0.90x, 3-4bp 1.25x; our own store 2-4bp 0.95x), and the
# blind control is 0.53x (EV -0.61, t -10). Our own venue shows the same effect
# but ~7x weaker (1-2bp 1.06x, <2bp EV +0.28 t 0.6, n=114), so this arm stays
# PAPER: it is here to measure whether the edge exists where we can trade it.
# The 13-day Polymarket order books are a placeholder (bid 0.1/ask 0.9 in 98% of
# rows), so prints-vs-asks is still unverified -- the biggest remaining caveat.
ticket_min_dist_bps=0.25
ticket_max_dist_bps=2.0
ticket_min_tau_s=3.0
ticket_max_tau_s=30.0
ticket_max_per_day=400
# LIVE, REAL MONEY (explicit instruction 2026-09-12). The arm now places REAL
# orders through the main arm's own path (_place_order -> buy -> _book_fill ->
# settle_due -> redeem), so the risk guard, the re-verification, the settlement
# and the redemption all apply, and there is one real-money code path rather
# than two. It also takes the round from the main arm (max_open_rounds=1), which
# is the point: no double exposure in a round.
# Enabled against this measured state, which is NOT proof:
#   our venue, <2bp: 1.20x (EV +0.28, t 0.6, n=114)
#   our venue, floor <=0.025: 3.27x break-even on 2 wins in 30 (day-t 0.43)
#   our venue, any distance: ~1.0x  (the venue is efficient elsewhere)
#   Polymarket, <2bp: 2.57x (t 3.2, n=243) -- a venue we cannot trade
# The rail that makes it survivable is the cap: 10/day is $10 of exposure, 18%
# of a ~$55 account in the worst case. Raise it deliberately, never by accident.
ticket_live=true
ticket_live_max_per_day=10
min_tau_s=60.0
max_tau_s=210.0
pricing_model=digital
up_model=digital
daily_loss_cap_pct=0.20
daily_loss_cap_usdt=0.0
max_consecutive_losses=5
