# Profile: control_digital -- the calibrated ("honest pricing") experiment OFF.
#
# Evidence (2026-09-12, 96,175 recorded ticks over 973 settled rounds, both
# models recomputed on the SAME ticks, outcomes from rounds.winner):
#
#   model                Brier     gate n   gate EV/$1 realised   claimed    t
#   venue's own ask      0.15208      -            -                -        -
#   digital (no params)  0.15729    825        +0.0775          +0.0544   +3.58
#   calibrated (live)    0.15311    938        +0.0123          +0.0460   +0.79
#
# The calibrated model is the more ACCURATE probability (it tracks the venue's
# favourite-longshot bias: realised 94.1% where the ask implies 89.7% between
# 0.85 and 0.95) but its gate earns 1/6th of what the parameter-free digital
# gate earns on identical ticks, under-delivers its own claims by 3.4 points,
# and flips sign between halves (+0.0338 then -0.0092). Honest pricing that
# loses money to the naive model it replaced does not get to stay live.
#
# What this profile changes: pricing_model and up_model only. Everything else
# is the last configuration with a positive live record (the 09:41-12:59 era:
# 230 fills, +$57.78, +8.63%/$1): 2% x inv_z tilt, $25 cap, floored to the
# venue minimum, market orders, tau 60-210, guards on (20% daily stop,
# 5-loss halt).
#
# Read it as: the digital arm is live, and the calibrated model is not deleted
# -- it can come back as a paper arm (ab_report compares it forward) and would
# have to beat digital on the same ticks to win its place back.
#
# Knobs only -- no keys, no endpoints. Apply with:
#   python -m tools.switch_env control_digital --restart
order_type=market
slippage_bps=300
sizing_mode=fraction
stake_fraction=0.02
stake_cap_usdt=25.0
stake_floor_to_minimum=true
stake_tilt=inv_z
tilt_reference_z=0.30
tilt_min=0.5
tilt_max=2.0
min_order_usdt=1.0
min_edge=0.01
min_quote=0.50
max_quote=0.90
min_tau_s=60.0
max_tau_s=210.0
signal_persistence=2
up_regime_gate=0.005
edge_haircut=1.0
side_filter=both
pricing_model=digital
up_model=digital
daily_loss_cap_pct=0.20
daily_loss_cap_usdt=0.0
max_consecutive_losses=5
