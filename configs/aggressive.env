# Profile: aggressive -- flat $10 a trade, no guards (live from 2026-09-11 13:05Z).
#
# A FLAT band (min == max) in edge mode with the tilt off, so every accepted
# signal stakes exactly $10.00 at every bankroll. The daily stop and the
# 5-loss halt are OFF: nothing but the wallet balance stops a losing day.
#
# At $104 of equity that is 9.6% per trade, and it does NOT shrink with the
# account -- see FINDINGS.md, "Flat $10 a trade" and "Flat $10 with no guards".
# In projection it has a similar median to the optimal profile and a much worse
# left tail; the projections' tails are not trustworthy at a fixed stake,
# which is itself the point: the fixed stake is what fails, not the numbers.
#
# Knobs only -- no keys, no endpoints, nothing secret. Apply with:
#   make config PROFILE=aggressive
order_type=market
slippage_bps=300
sizing_mode=edge
min_stake_usdt=10.0
max_stake_usdt=10.0
stake_cap_usdt=10.0
stake_fraction=0.12
stake_floor_to_minimum=false
stake_tilt=none
tilt_reference_z=0.30
tilt_min=0.5
tilt_max=2.0
sizing_metric=ev
stake_ev_lo=0.15
stake_ev_hi=0.45
stake_usdt=7.0
min_order_usdt=1.0
bankroll_usdt=40.0
daily_loss_cap_pct=0.0
daily_loss_cap_usdt=0.0
max_consecutive_losses=0
pricing_model=calibrated_down
up_model=calibrated
min_edge=0.01
min_quote=0.50
edge_haircut=1.0
side_filter=both
signal_persistence=2
max_tau_s=210.0
trade_on_candle_open=false
up_regime_gate=0.005
