# Profile: optimal_guarded -- the honest-pricing config as it actually ran
# (2026-09-11 09:41-12:59Z), guards ON.
#
# Same sizing as `optimal` (2% x inv_z tilt, $25 cap, floored at the venue
# minimum) but with the 20% daily stop and the 5-loss halt in place. At a $29
# account those two are ~$5.80 and ~$5.00: the daily stop trips after three to
# five losses, and the halt after five, both day-scoped.
#
# Kept because the user asked for the old config to stay switchable, and
# because "guards off" and "guards on" are different strategies -- the era
# above ran with these on and its numbers describe that, not this.
#
# Knobs only -- no keys, no endpoints, nothing secret. Apply with:
#   make config PROFILE=optimal_guarded
order_type=market
slippage_bps=300
sizing_mode=fraction
stake_fraction=0.02
stake_cap_usdt=25.0
stake_floor_to_minimum=true
stake_tilt=inv_z
tilt_reference_z=0.30
tilt_min=0.5
tilt_max=2.0
min_stake_usdt=5.0
max_stake_usdt=10.0
sizing_metric=ev
stake_ev_lo=0.15
stake_ev_hi=0.45
stake_usdt=7.0
min_order_usdt=1.0
bankroll_usdt=40.0
daily_loss_cap_pct=0.20
daily_loss_cap_usdt=0.0
max_consecutive_losses=5
pricing_model=calibrated_down
up_model=calibrated
min_edge=0.01
min_quote=0.50
edge_haircut=1.0
side_filter=both
signal_persistence=2
max_tau_s=210.0
trade_on_candle_open=false
up_regime_gate=0.005
