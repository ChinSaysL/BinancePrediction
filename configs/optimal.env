# Profile: optimal -- the honest-pricing sizing, with the guards OFF.
#
# 2% of the live bankroll x the inv_z tilt, $25 stake cap, floored to the venue
# minimum when the fraction cannot reach it. Daily stop and 5-loss halt are
# OFF, at the user's instruction on 2026-09-11: nothing but the wallet balance
# stops a losing run. The guarded version of this same sizing is kept as
# `optimal_guarded` (it is what the 09:41-12:59 era actually ran).
#
# What that era measured with the guards ON: 35 settled trades, 80.0% win rate,
# EV +0.110/$1 (t = 1.11), +$13.02 -- and the name is a PREFERENCE, not a
# result: 35 trades with t ~ 1 is not evidence. Its projection from $103.76
# (600 paths, 30 days) was median $886, p10 $397, P(DD>50%) 0.3%, ruin 0%.
# What turning the guards off does at a FLAT stake was measured on 2026-09-11
# (see FINDINGS.md): the day is no longer truncated, ~+36% median, worse tail
# behaviour on paper and unmeasurable in practice.
#
# Knobs only -- no keys, no endpoints, nothing secret. Apply with:
#   make config PROFILE=optimal
#
# This is the CONTROL arm of the slippage experiment: the venue's FOK order
# takes up to 300bps off the quote (its default), which is what produced the
# 53-fill record whose median fill paid +175bps over the quote. The experiment
# arm -- same everything, 100bps of room -- is `optimal_slip100`.
order_type=market
slippage_bps=300
sizing_mode=fraction
stake_fraction=0.02
stake_cap_usdt=25.0
stake_floor_to_minimum=true
stake_tilt=inv_z
tilt_reference_z=0.30
tilt_min=0.5
tilt_max=2.0
min_stake_usdt=5.0
max_stake_usdt=10.0
sizing_metric=ev
stake_ev_lo=0.15
stake_ev_hi=0.45
stake_usdt=7.0
min_order_usdt=1.0
bankroll_usdt=40.0
daily_loss_cap_pct=0.0
daily_loss_cap_usdt=0.0
max_consecutive_losses=0
pricing_model=calibrated_down
up_model=calibrated
min_edge=0.01
min_quote=0.50
edge_haircut=1.0
side_filter=both
signal_persistence=2
max_tau_s=210.0
trade_on_candle_open=false
up_regime_gate=0.005
